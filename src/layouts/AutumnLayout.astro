---
import BaseHead from '../components/BaseHead.astro';
import StructuredData from '../components/StructuredData.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  pubDate: string;
  canonicalURL: string | any;
  robotsTag: string;
}

const { title, metaTitle, description, pubDate, robotsTag, canonicalURL = Astro.url } = Astro.props;

---
<html lang="en-GB">
  <BaseHead {title} {metaTitle} {description} {canonicalURL} {robotsTag}/>
  <body>
    <main>
      <slot />
  </main>
  <StructuredData {title} {pubDate} {description} />
  </body>
</html>