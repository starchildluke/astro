---
import Layout from '../layouts/Layout.astro';
import NewCurrentlyListening from '../components/NewCurrentlyListening.astro';
import Pokeballs from '../components/Pokeballs.astro';
import Latest from '../components/Latest.astro';
// import LatestAlbums from '../components/LatestAlbums.astro';
import sd from '../data/sd.json';

// METADATA VARIABLES
const metaTitle = 'Luke Davis: technical SEO, music producer & creator';
const title = 'Luke Davis';
const description = 'The digital home of Luke Davis: a senior technical SEO, music producer, and blogger based in the UK.';

const greetings = {
  'pt': ['bom dia!', 'boa tarde!', 'boa noite!', 'ola!'],
  'es': ['¡buenos dias!', '¡buenos tardes!', '¡buenos noches!', '¡hola!'],
  'en': ['good morning!', 'good afternoon!', 'good evening!', 'hello!'],
  'fr': ['bonjour!', 'bonsoir!']
};

const langs = Object.keys(greetings);
const randLangs = langs[Math.floor(Math.random()*langs.length)]
const sayHello = greetings[randLangs][Math.floor(Math.random()*greetings[randLangs].length)];
---

<style>

  h2 ul li {
    margin-bottom: 2rem;
  }

  ul {
    margin-bottom: 0;
  }

  @media only screen and (max-width:800px) {
    .layout > article {
      grid-column: 1;
      margin: 0 1rem;
    }
  }

  #welcome {
    font-family: DM Serif Display, Times New Roman, serif;
    font-size: 3rem;
  }

  .tagline {
    font-size: 1.75rem;
    font-weight: 450;
    line-height: 1.4;
  }

  .tagline a {
    text-decoration: none;
    font-weight: bold;
  }

  .tagline a:hover {
    text-decoration: underline;
    text-decoration-thickness: calc(var(--space-xs) / 4);
  }

  #hello:lang(pt, es, fr) {
    font-style: normal;
  }

  @media only screen and (max-width:480px) {

    #welcome {
      font-size: 2.5rem;
      line-height: 1;
      margin-bottom: var(--space-md);
    }

    .tagline {
      font-size: 1.25rem;
      line-height: 1.4;
    }

  }

  .home-middle {
    text-align: center;
  }

</style>

<Layout title={title} metaTitle={metaTitle} description={description}>
  <div class="home-middle">
    <div id="welcome">
      {greetings[randLangs] !== "en" ?
        <span id="hello" lang={randLangs}>
          {sayHello}
        </span>
        : <span id="hello">sayHello</span>}
    </div>
    <p class="tagline">I'm a <a href="/jardim/tech/seo/" style="color:var(--red)">senior technical SEO specialist</a>, <a href="/music/">music producer</a>, and <a href="/posts/" style="color:var(--blue)">blogger</a> based in Nottingham, UK.</p>
  </div>
  <Pokeballs />
  <Latest />
  <Pokeballs />
  <NewCurrentlyListening />
<script type="application/ld+json" set:html={JSON.stringify(sd)}></script>
</Layout>