---
// COMPONENTS

import AutumnLayout from '../layouts/AutumnLayout.astro';
import {Content as AutumnLeaves} from '../data/autumn-posts.mdx';

// METADATA VARIABLES

let title = 'Autumnal altar';
let description = 'This is my digital autumnal altar for autumn 2025.';

---

<style>

  :root {
    --fulvous: #DF880F;
    --tigers-eye: #A76309;
    --hunyadi-yellow: #F0B757;
    --licorice: #100207;
    --deeper-hunyadi-yellow: #F1AC3B;
    --roastery: #641906;
  }

  body {
    color: var(--licorice);
  }

  :global(a) {
    text-decoration: none;
  }
  
  body {
    margin: 4rem;
    background: var(--deeper-hunyadi-yellow);
    display: flex;
    align-items: normal;
  }

  img[src*="gif"] {
    image-rendering: pixelated;
  }

  #equinox {
    transition: font-weight 1s;
  }

  #equinox:hover {
    color: var(--roastery);
    font-weight: 900;
  }

  .autumn-leaves {
    font-size: var(--space-lg);
  }

</style>

<AutumnLayout title={title} description={description} robotsTag='noindex, nofollow'>
    <h1>Autumn</h1>
      <section class="space-lg"><p>The <span id="equinox">autumn equinox</span> occurred on <time>Wed, 23 Sept 2026, 1:06am</time> in the UK, marking the start of autumn.</p>
        <p>This year's autumn will last 89 days, 19 hours, 43 minutes.</p>
        <img src="/images/pumpkins.gif" alt="a bunch of low res pumpkins" width="500" height="333" fetchpriority="high" />
      </section>
      <h3>Click the leaves to find new pages about autumn</h3>
      <div class="autumn-leaves">
        <AutumnLeaves />
      </div>
</AutumnLayout>