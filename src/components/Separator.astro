---

// EXAMPLE: <Separator sep="❦ ❦ ❦" color="--green" />

const { sep, color } = Astro.props;

const colorType = color.startsWith('--') ? `color: var(${color})` : `color: ${color}`;
---

<style>
	.separator {
		text-align: center;
		font-size: 1.5rem;
	}


</style>

<p class="separator" style=`${colorType}`>{sep}</p>