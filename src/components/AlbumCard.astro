---

import FormattedDate from "./FormattedDate.astro";

const { title, linerNotes, pubDate, image, url } = Astro.props;

---

<style>

	.album-name h1 {
		margin-top: 0;
	}
	
	.album-card {
		display: flex;
		flex-direction: column;
	}

	.album-cover img {
		max-width: 500px;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.album-cover figure {
		margin: 0
	}

	.album-liner-notes {
		max-width: 750px;
		margin-bottom: 2rem;
	}

	.album-liner-notes p {
		font-family: Georgia, serif;
		font-style: italic;
	}

	.album-liner-notes blockquote {
		margin-left: 0.75rem;
		border-left: 0.75rem solid #e09e3e;
		padding-left: 1rem;
		font-size: 1.1rem;
		font-style: italic;
		font-family: Georgia, 'Times New Roman', Times, serif;
	}

	.album-liner-notes blockquote:before {
		content: '\201C';
	}

	.album-liner-notes blockquote:after {
		content: '\201D';
	}

	.album-download {
		margin-top: 1rem;
	}

</style>

<div class="album-card">
	<div class="album-name">
		<h1>{title}</h1>
	</div>
	<div class="album-cover">
			<img src={`/images/albums/full/${image}`} alt={`cover art for ${title}`} width="500" height="500" loading="eager" fetchpriority="high" />
	</div>
	<div class="album-meta">
		<div class="album-liner-notes">
			<h2>About {title}</h2>
			<blockquote>{linerNotes}</blockquote>
		</div>
		<div class="album-release-date">
			<div class="album-download">
			<p><a href={url}>Download {title} on Bandcamp</a>.</p>
			</div>
		</div>
	</div>
</div>